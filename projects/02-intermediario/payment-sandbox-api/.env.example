POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-with-a-local-admin-password

APP_DB_NAME=payments
APP_DB_USER=payments
APP_DB_PASSWORD=replace-with-a-local-password

# Optional isolated demo database and user: payments_demo.
# Set before preparing the demo database; keep the real value only in .env.
DEMO_DB_PASSWORD=replace-with-a-local-demo-password

KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-a-local-password

KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-local-password
